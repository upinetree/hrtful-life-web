---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const titlePrefix = "HRTful Life";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="A portal site for Takuya Matsumoto" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-noto-sans-jp" />
    <Font cssVariable="--font-noto-color-emoji" />
    <Font cssVariable="--font-moirai-one" />
    <meta name="generator" content={Astro.generator} />
    <title>{titlePrefix} - {title}</title>
    <ClientRouter />
  </head>
  <body>
    <div
      class="min-h-screen bg-gradient-to-br from-spring-sky-100 to-spring-field-100 font-normal"
    >
      <Header brand="HRTful.life" />
      <main class="hrt-container">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  .hrt-container {
    @apply max-w-[65rem] mx-auto px-4;
  }
</style>
